// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS for dropdown/status fields ---

enum UserRole {
  SUPER_ADMIN
  STANDARD_USER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum AssignmentRole {
  RELATIONSHIP
  DOCTOR
  ACCOUNT_SERVICE
}

enum ClientStatus {
  NEW_LEAD
  CONTACTED
  NURTURING
  STRATEGY_SESSION
  ACTIVE_CLIENT
  ARCHIVED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum DealStatus {
  PROPOSED
  WON
  LOST
  ON_HOLD
}

enum DealType {
  MARKETING
  INVESTMENT
  MEDICAL
  CUSTOM
}

enum DealParticipantRole {
  RELATIONSHIP
  FOLLOW_UP
  DOCTOR
  COMPANY
  EXTERNAL_PARTNER
}

enum StrategyStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  NEEDS_REVISION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityLogType {
  NOTE
  CALL
  EMAIL
  MEETING
  SYSTEM
}

enum LeadSourceType {
  GOOGLE_FORMS
  PROFIT_PULSE_ALLY
  MANUAL
  OTHER
}

enum ClientContactKind {
  EMAIL
  PHONE
}

enum StrategyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StrategyStepType {
  EXISTING_DEAL
  PLANNED_DEAL
  MANUAL
}

enum StrategyConnectionType {
  FUNDING_SOURCE
  INTEREST_REDIRECT
  INCOME_REDIRECT
  CAPITAL_GROWTH
  PROTECTION_SUPPORT
  TAX_PLANNING
  RISK_MANAGEMENT
  MANUAL
}

enum StrategyIncomeFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  CUSTOM
}

enum StrategyExpenseFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  CUSTOM
}

enum StrategyExpenseCategory {
  HOUSING
  EDUCATION
  HEALTHCARE
  INSURANCE
  RETIREMENT
  LIFESTYLE
  BUSINESS
  DEBT
  FAMILY_SUPPORT
  EMERGENCY
  OTHER
}

enum StrategyExpensePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// --- CORE MODELS ---

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String?    @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  authoredStrategies    Strategy[]             @relation("StrategyAuthor")
  clientAssignments     ClientAssignment[]
  loggedInteractions    Interaction[]
  assignedTasks         Task[]                 @relation("TaskAssignee")
  loggedActivityEvents  ClientActivityLog[]    @relation("ActivityLogAuthor")
  activityReadStatuses  ActivityReadStatus[]
  receivedNotifications Notification[]         @relation("ReceivedNotifications")
  sentNotifications     Notification[]         @relation("SentNotifications")
  commissionReturnables CommissionReturnable[]
  dealParticipants      DealParticipant[]
  ownedStrategyPlans    ClientStrategyPlan[]   @relation("StrategyPlanOwner")
  createdStrategyPlans  ClientStrategyPlan[]   @relation("StrategyPlanCreator")
  createdImportantDates ClientImportantDate[]  @relation("ImportantDateCreatedBy")
  updatedImportantDates ClientImportantDate[]  @relation("ImportantDateUpdatedBy")
}

model Client {
  id                   String       @id @default(cuid())
  name                 String
  company              String?
  contactInfo          String?
  email                String?
  phone                String?
  leadSource           String?      @map("lead_source")
  dealValue            Decimal?     @map("deal_value") @db.Decimal(12, 2)
  equity               Decimal?     @db.Decimal(12, 2)
  strategyText         String?      @map("strategy_text") @db.Text
  roleInCompany        String?      @map("role_in_company")
  employeeCount        Int?         @map("employee_count")
  expectations         String?      @db.Text
  /// @deprecated Prefer ClientImportantDate rows. Kept for rollback / dual-read during transition.
  importantDates       Json?        @default("[]") @map("important_dates") @db.JsonB
  status               ClientStatus @default(NEW_LEAD)
  pendingNotifications Boolean      @default(false)
  priority             String?
  nextAction           String?      @map("next_action")
  nextFollowUpAt       DateTime?    @map("next_follow_up_at")
  createdAt            DateTime     @default(now())
  lastModified         DateTime     @updatedAt

  // Relations
  clientAssignments ClientAssignment[]
  interactions      Interaction[]
  deals             Deal[]
  notifications     Notification[]
  strategies        Strategy[]
  documents         ClientDocument[]
  tasks             Task[]
  activityLogs      ClientActivityLog[]
  sourceRecords     ClientSourceRecord[]
  tags              ClientTag[]
  strategyPlans     ClientStrategyPlan[] @relation("ClientStrategyPlans")
  importantDateRecords ClientImportantDate[] @relation("ClientImportantDates")
  contacts          ClientContact[]      @relation("ClientContacts")

  @@index([nextFollowUpAt])
}

/**
 * Additional emails/phones for a client/lead.
 * Client.email / Client.phone remain the primary mirrors (first / isPrimary) for
 * legacy search, LCC, and simple displays during the transition.
 */
model ClientContact {
  id              String            @id @default(cuid())
  clientId        String            @map("client_id")
  kind            ClientContactKind
  value           String
  normalizedValue String            @map("normalized_value")
  label           String?
  isPrimary       Boolean           @default(false) @map("is_primary")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  client Client @relation("ClientContacts", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, normalizedValue])
  @@index([clientId, kind, sortOrder])
  @@index([kind, normalizedValue])
  @@map("client_contacts")
}

/**
 * Client/Lead important dates (leads are Client rows; API may expose the id as leadId).
 * `scheduledAt` is the single datetime; `hasTime=false` means all-day (date only).
 * Calendar widgets should query this table and use classifyImportantDateRecordType(status).
 */
model ClientImportantDate {
  id          String   @id @default(cuid())
  label       String
  scheduledAt DateTime @map("scheduled_at")
  hasTime     Boolean  @default(false) @map("has_time")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clientId String @map("client_id")
  client   Client @relation("ClientImportantDates", fields: [clientId], references: [id], onDelete: Cascade)

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("ImportantDateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String? @map("updated_by_user_id")
  updatedBy       User?   @relation("ImportantDateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId, scheduledAt])
  @@index([scheduledAt])
  @@map("client_important_dates")
}

model ClientAssignment {
  assignmentId String         @id @default(cuid()) @map("assignment_id")
  clientId     String         @map("client_id")
  userId       String         @map("user_id")
  role         AssignmentRole

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("client_assignments")
}

model Interaction {
  id      String          @id @default(cuid())
  type    InteractionType
  content String          @db.Text
  date    DateTime        @default(now())

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User who logged it
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

model Deal {
  id              String     @id @default(cuid())
  name            String
  dealValue       Decimal    @db.Decimal(12, 2)
  totalCommission Decimal    @db.Decimal(12, 2)
  dealType        DealType   @default(CUSTOM)
  status          DealStatus @default(PROPOSED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  commissionReturnables CommissionReturnable[]
  participants          DealParticipant[]
  strategySteps         ClientStrategyStep[] @relation("StrategyStepLinkedDeal")

  @@index([clientId, status])
  @@index([status, updatedAt])
}

model DealParticipant {
  id                   String              @id @default(cuid())
  dealId               String
  userId               String?
  externalName         String?
  role                 DealParticipantRole
  commissionPercent    Decimal             @db.Decimal(5, 2)
  commissionAmount     Decimal?            @db.Decimal(12, 2)
  isCommissionable     Boolean             @default(true)
  returnablePercent    Decimal?            @db.Decimal(5, 2)
  returnableAmount     Decimal?            @db.Decimal(12, 2)
  isReturnableRequired Boolean             @default(false)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  deal Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([userId])
  @@index([role])
}

model Strategy {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  status      StrategyStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relation to Client
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User (Author)
  authorId String
  author   User   @relation("StrategyAuthor", fields: [authorId], references: [id])

  // Relation to Documents
  documents Document[]
}

model Document {
  id         String   @id @default(cuid())
  name       String
  url        String // URL from a storage provider like Supabase Storage
  uploadedAt DateTime @default(now())

  // Relation to Strategy
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model Notification {
  notificationId  String   @id @default(cuid()) @map("notification_id")
  recipientUserId String   @map("recipient_user_id")
  senderUserId    String   @map("sender_user_id")
  message         String   @db.Text
  linkedClientId  String?  @map("linked_client_id")
  isRead          Boolean  @default(false) @map("is_read")
  timestamp       DateTime @default(now())

  recipient User    @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sender    User    @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model ClientDocument {
  id         String   @id @default(cuid())
  fileName   String   @map("file_name")
  url        String
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?  @map("due_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueDate])
  @@map("tasks")
}

model ClientActivityLog {
  id        String          @id @default(cuid())
  type      ActivityLogType
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation("ActivityLogAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("client_activity_logs")
}

model ActivityReadStatus {
  activityLogId String   @map("activity_log_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityLogId, userId])
  @@index([userId])
  @@map("activity_read_status")
}

model CommissionReturnable {
  id     String   @id @default(cuid())
  amount Decimal  @db.Decimal(10, 2)
  status String   @default("UNPAID") // "UNPAID" or "PAID"
  period DateTime // The first day of the month this was generated

  userId String
  user   User   @relation(fields: [userId], references: [id])

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, period])
}

model ClientSourceRecord {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  source          LeadSourceType
  externalId      String?        @map("external_id")
  normalizedEmail String?        @map("normalized_email")
  normalizedPhone String?        @map("normalized_phone")
  payload         Json           @db.JsonB
  receivedAt      DateTime       @default(now()) @map("received_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([clientId])
  @@index([source])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("client_source_records")
}

model LeadMergeAudit {
  id                String   @id @default(cuid())
  canonicalClientId String   @map("canonical_client_id")
  mergedClientId    String?  @map("merged_client_id")
  mergedByUserId    String?  @map("merged_by_user_id")
  mergeType         String   @map("merge_type")
  reason            String?
  fieldChanges      Json?    @map("field_changes") @db.JsonB
  conflicts         Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("lead_merge_audits")
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  clients   ClientTag[]
}

model ClientTag {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, tagId])
  @@index([clientId])
  @@index([tagId])
}

// --- CLIENT STRATEGY BUILDER ---

model ClientStrategyPlan {
  id              String             @id @default(cuid())
  clientId        String
  title           String
  description     String?            @db.Text
  clientGoal      String?            @db.Text
  expectedOutcome String?            @db.Text
  status          StrategyPlanStatus @default(DRAFT)
  ownerUserId     String?
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  client    Client @relation("ClientStrategyPlans", fields: [clientId], references: [id], onDelete: Cascade)
  owner     User?  @relation("StrategyPlanOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy User   @relation("StrategyPlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  steps       ClientStrategyStep[]       @relation("StrategyPlanSteps")
  connections ClientStrategyConnection[] @relation("StrategyPlanConnections")
  expenses    ClientStrategyExpense[]    @relation("StrategyPlanExpenses")

  @@index([clientId])
  @@index([clientId, status])
  @@index([ownerUserId])
  @@index([createdByUserId])
}

model ClientStrategyStep {
  id                      String                   @id @default(cuid())
  strategyPlanId          String
  linkedDealId            String?
  title                   String
  stepType                StrategyStepType         @default(MANUAL)
  plannedAmount           Decimal?                 @db.Decimal(12, 2)
  amountDescription       String?
  purpose                 String?                  @db.Text
  expectedAchievement     String?                  @db.Text
  expectedIncomeAmount    Decimal?                 @db.Decimal(12, 2)
  expectedIncomeFrequency StrategyIncomeFrequency?
  timelineLabel           String?
  sortOrder               Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  strategyPlan ClientStrategyPlan @relation("StrategyPlanSteps", fields: [strategyPlanId], references: [id], onDelete: Cascade)
  linkedDeal   Deal?              @relation("StrategyStepLinkedDeal", fields: [linkedDealId], references: [id], onDelete: SetNull)

  outgoingConnections ClientStrategyConnection[] @relation("StrategyConnectionFromStep")
  incomingConnections ClientStrategyConnection[] @relation("StrategyConnectionToStep")
  coveringExpenses    ClientStrategyExpense[]    @relation("StrategyExpenseCoveredByStep")

  @@index([strategyPlanId])
  @@index([linkedDealId])
  @@index([strategyPlanId, sortOrder])
}

model ClientStrategyConnection {
  id              String                 @id @default(cuid())
  strategyPlanId  String
  fromStepId      String
  toStepId        String
  connectionType  StrategyConnectionType @default(MANUAL)
  purpose         String?                @db.Text
  expectedOutcome String?                @db.Text
  timing          String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  strategyPlan ClientStrategyPlan @relation("StrategyPlanConnections", fields: [strategyPlanId], references: [id], onDelete: Cascade)
  fromStep     ClientStrategyStep @relation("StrategyConnectionFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep       ClientStrategyStep @relation("StrategyConnectionToStep", fields: [toStepId], references: [id], onDelete: Cascade)

  @@index([strategyPlanId])
  @@index([fromStepId])
  @@index([toStepId])
}

model ClientStrategyExpense {
  id                 String                   @id @default(cuid())
  strategyPlanId     String
  title              String
  category           StrategyExpenseCategory
  amount             Decimal?                 @db.Decimal(12, 2)
  frequency          StrategyExpenseFrequency
  startTimelineLabel String?
  endTimelineLabel   String?
  priority           StrategyExpensePriority  @default(MEDIUM)
  purpose            String?                  @db.Text
  coveredByStepId    String?
  notes              String?                  @db.Text
  sortOrder          Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  strategyPlan  ClientStrategyPlan  @relation("StrategyPlanExpenses", fields: [strategyPlanId], references: [id], onDelete: Cascade)
  coveredByStep ClientStrategyStep? @relation("StrategyExpenseCoveredByStep", fields: [coveredByStepId], references: [id], onDelete: SetNull)

  @@index([strategyPlanId])
  @@index([coveredByStepId])
  @@index([strategyPlanId, sortOrder])
}
