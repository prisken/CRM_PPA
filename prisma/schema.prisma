// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RELATIONSHIP
  DOCTOR
  SERVICE
}

enum ClientStatus {
  NEW_LEAD
  NURTURING
  STRATEGY_SESSION
  ACTIVE
}

enum DealStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  ON_HOLD
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
  MESSAGE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String
  role         UserRole
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt

  adminClients        Client[] @relation("AssignedAdmin")
  relationshipClients Client[] @relation("AssignedRelationshipSpecialist")
  doctorClients       Client[] @relation("AssignedDoctor")
  serviceClients      Client[] @relation("AssignedServiceSpecialist")

  clientAssignments ClientUserAssignment[]
  interactions      Interaction[]

  @@map("users")
}

model Client {
  id                   String       @id @default(cuid())
  firstName            String
  lastName             String
  company              String?
  email                String?
  phone                String?
  status               ClientStatus @default(NEW_LEAD)
  pendingNotifications Boolean      @default(false)
  createdAt            DateTime     @default(now())
  lastModified         DateTime     @updatedAt

  assignedAdminId                  String?
  assignedRelationshipSpecialistId String?
  assignedDoctorId                 String?
  assignedServiceSpecialistId      String?

  assignedAdmin                  User? @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedRelationshipSpecialist User? @relation("AssignedRelationshipSpecialist", fields: [assignedRelationshipSpecialistId], references: [id], onDelete: SetNull)
  assignedDoctor                 User? @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  assignedServiceSpecialist      User? @relation("AssignedServiceSpecialist", fields: [assignedServiceSpecialistId], references: [id], onDelete: SetNull)

  userAssignments ClientUserAssignment[]
  interactions    Interaction[]
  deals           Deal[]
  strategies      Strategy[]

  @@map("clients")
}

model ClientUserAssignment {
  id           String   @id @default(cuid())
  clientId     String
  userId       String
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_user_assignments")
}

model Interaction {
  id           String          @id @default(cuid())
  type         InteractionType
  title        String?
  notes        String?
  occurredAt   DateTime        @default(now())
  clientId     String
  userId       String
  createdAt    DateTime        @default(now())
  lastModified DateTime        @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("interactions")
}

model Deal {
  id           String     @id @default(cuid())
  title        String
  description  String?
  value        Decimal?   @db.Decimal(12, 2)
  status       DealStatus @default(OPEN)
  clientId     String
  createdAt    DateTime   @default(now())
  lastModified DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("deals")
}

model Strategy {
  id           String         @id @default(cuid())
  title        String
  description  String?
  status       StrategyStatus @default(DRAFT)
  clientId     String
  createdAt    DateTime       @default(now())
  lastModified DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("strategies")
}
