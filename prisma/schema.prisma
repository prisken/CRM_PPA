// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS for dropdown/status fields ---

enum UserRole {
  SUPER_ADMIN
  STANDARD_USER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum AssignmentRole {
  RELATIONSHIP
  DOCTOR
  ACCOUNT_SERVICE
}

enum ClientStatus {
  NEW_LEAD
  CONTACTED
  NURTURING
  STRATEGY_SESSION
  ACTIVE_CLIENT
  ARCHIVED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum DealStatus {
  PROPOSED
  WON
  LOST
  ON_HOLD
}

enum StrategyStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  NEEDS_REVISION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityLogType {
  NOTE
  CALL
  EMAIL
  MEETING
  SYSTEM
}

enum LeadSourceType {
  GOOGLE_FORMS
  PROFIT_PULSE_ALLY
  MANUAL
  OTHER
}


// --- CORE MODELS ---

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  passwordHash       String?            @map("password_hash")
  role               UserRole
  status             UserStatus         @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  authoredStrategies    Strategy[]         @relation("StrategyAuthor")
  clientAssignments     ClientAssignment[]
  loggedInteractions    Interaction[]
  assignedTasks         Task[]             @relation("TaskAssignee")
  loggedActivityEvents  ClientActivityLog[] @relation("ActivityLogAuthor")
  activityReadStatuses  ActivityReadStatus[]
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  sentNotifications     Notification[]     @relation("SentNotifications")
  commissionReturnables CommissionReturnable[]
}

model Client {
  id                   String             @id @default(cuid())
  name                 String
  company              String?
  contactInfo          String?
  email                String?
  phone                String?
  leadSource           String?            @map("lead_source")
  dealValue            Decimal?           @db.Decimal(12, 2) @map("deal_value")
  equity               Decimal?           @db.Decimal(12, 2)
  strategyText         String?            @db.Text @map("strategy_text")
  roleInCompany        String?            @map("role_in_company")
  employeeCount        Int?               @map("employee_count")
  expectations         String?            @db.Text
  importantDates       Json?              @default("[]") @db.JsonB @map("important_dates")
  status               ClientStatus       @default(NEW_LEAD)
  pendingNotifications Boolean            @default(false)
  createdAt            DateTime           @default(now())
  lastModified         DateTime           @updatedAt

  // Relations
  clientAssignments    ClientAssignment[]
  interactions         Interaction[]
  deals                Deal[]
  notifications        Notification[]
  strategies           Strategy[]
  documents            ClientDocument[]
  tasks                Task[]
  activityLogs         ClientActivityLog[]
  sourceRecords        ClientSourceRecord[]
}

model ClientAssignment {
  assignmentId String         @id @default(cuid()) @map("assignment_id")
  clientId     String         @map("client_id")
  userId       String         @map("user_id")
  role         AssignmentRole

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("client_assignments")
}

model Interaction {
  id       String          @id @default(cuid())
  type     InteractionType
  content  String          @db.Text
  date     DateTime        @default(now())

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User who logged it
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

model Deal {
  id          String     @id @default(cuid())
  name        String
  dealValue        Decimal    @db.Decimal(12, 2)
  totalCommission  Decimal    @db.Decimal(12, 2)
  status      DealStatus @default(PROPOSED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  commissionReturnables CommissionReturnable[]

  @@index([clientId, status])
  @@index([status, updatedAt])
}

model Strategy {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  status      StrategyStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relation to Client
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User (Author)
  authorId String
  author   User   @relation("StrategyAuthor", fields: [authorId], references: [id])

  // Relation to Documents
  documents Document[]
}

model Document {
  id         String   @id @default(cuid())
  name       String
  url        String // URL from a storage provider like Supabase Storage
  uploadedAt DateTime @default(now())

  // Relation to Strategy
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model Notification {
  notificationId  String   @id @default(cuid()) @map("notification_id")
  recipientUserId String   @map("recipient_user_id")
  senderUserId    String   @map("sender_user_id")
  message         String   @db.Text
  linkedClientId  String?  @map("linked_client_id")
  isRead          Boolean  @default(false) @map("is_read")
  timestamp       DateTime @default(now())

  recipient User    @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sender    User    @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model ClientDocument {
  id         String   @id @default(cuid())
  fileName   String   @map("file_name")
  url        String
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?  @map("due_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueDate])
  @@map("tasks")
}

model ClientActivityLog {
  id        String          @id @default(cuid())
  type      ActivityLogType
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation("ActivityLogAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("client_activity_logs")
}

model ActivityReadStatus {
  activityLogId String   @map("activity_log_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityLogId, userId])
  @@index([userId])
  @@map("activity_read_status")
}

model CommissionReturnable {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("UNPAID") // "UNPAID" or "PAID"
  period    DateTime // The first day of the month this was generated

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, period])
}

model ClientSourceRecord {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  source          LeadSourceType
  externalId      String?        @map("external_id")
  normalizedEmail String?        @map("normalized_email")
  normalizedPhone String?        @map("normalized_phone")
  payload         Json           @db.JsonB
  receivedAt      DateTime       @default(now()) @map("received_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([clientId])
  @@index([source])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("client_source_records")
}

model LeadMergeAudit {
  id                String   @id @default(cuid())
  canonicalClientId String   @map("canonical_client_id")
  mergedClientId    String?  @map("merged_client_id")
  mergedByUserId    String?  @map("merged_by_user_id")
  mergeType         String   @map("merge_type")
  reason            String?
  fieldChanges      Json?    @db.JsonB @map("field_changes")
  conflicts         Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("lead_merge_audits")
}
