// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS for dropdown/status fields ---

enum UserRole {
  SUPER_ADMIN
  STANDARD_USER
}

enum AssignmentRole {
  RELATIONSHIP
  DOCTOR
  ACCOUNT_SERVICE
}

enum ClientStatus {
  NEW_LEAD
  CONTACTED
  NURTURING
  STRATEGY_SESSION
  ACTIVE_CLIENT
  ARCHIVED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum DealStatus {
  PROPOSED
  WON
  LOST
  ON_HOLD
}

enum StrategyStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  NEEDS_REVISION
}


// --- CORE MODELS ---

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  role               UserRole
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  authoredStrategies    Strategy[]         @relation("StrategyAuthor")
  clientAssignments     ClientAssignment[]
  loggedInteractions    Interaction[]
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  sentNotifications     Notification[]     @relation("SentNotifications")
}

model Client {
  id                   String             @id @default(cuid())
  name                 String
  company              String?
  contactInfo          String?
  status               ClientStatus       @default(NEW_LEAD)
  pendingNotifications Boolean            @default(false)
  createdAt            DateTime           @default(now())
  lastModified         DateTime           @updatedAt

  // Relations
  clientAssignments    ClientAssignment[]
  interactions         Interaction[]
  deals                Deal[]
  notifications        Notification[]
}

model ClientAssignment {
  assignmentId String         @id @default(cuid()) @map("assignment_id")
  clientId     String         @map("client_id")
  userId       String         @map("user_id")
  role         AssignmentRole

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_assignments")
}

model Interaction {
  id       String          @id @default(cuid())
  type     InteractionType
  content  String          @db.Text
  date     DateTime        @default(now())

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User who logged it
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id          String     @id @default(cuid())
  name        String
  dealValue   Decimal    @db.Decimal(12, 2)
  grossProfit Decimal    @db.Decimal(12, 2)
  status      DealStatus @default(PROPOSED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relation to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Strategy {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  status      StrategyStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relation to User (Author)
  authorId String
  author   User   @relation("StrategyAuthor", fields: [authorId], references: [id])

  // Relation to Documents
  documents Document[]
}

model Document {
  id         String   @id @default(cuid())
  name       String
  url        String // URL from a storage provider like Supabase Storage
  uploadedAt DateTime @default(now())

  // Relation to Strategy
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model Notification {
  notificationId  String   @id @default(cuid()) @map("notification_id")
  recipientUserId String   @map("recipient_user_id")
  senderUserId    String   @map("sender_user_id")
  message         String   @db.Text
  linkedClientId  String?  @map("linked_client_id")
  isRead          Boolean  @default(false) @map("is_read")
  timestamp       DateTime @default(now())

  recipient User    @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sender    User    @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)

  @@map("notifications")
}
