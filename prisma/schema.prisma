// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS for dropdown/status fields ---

enum UserRole {
  ADMIN
  RELATIONSHIP
  DOCTOR
  SERVICE
}

enum ClientStatus {
  NEW_LEAD
  CONTACTED
  NURTURING
  STRATEGY_SESSION
  ACTIVE_CLIENT
  ARCHIVED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum DealStatus {
  PROPOSED
  WON
  LOST
  ON_HOLD
}

enum StrategyStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  NEEDS_REVISION
}


// --- CORE MODELS ---

model User {
  id                            String        @id @default(cuid())
  name                          String?
  email                         String        @unique
  role                          UserRole
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  // Relations
  authoredStrategies            Strategy[]    @relation("StrategyAuthor")
  assignedAdminClients          Client[]      @relation("AdminAssignment")
  assignedRelationshipClients   Client[]      @relation("RelationshipAssignment")
  assignedDoctorClients         Client[]      @relation("DoctorAssignment")
  assignedServiceClients        Client[]      @relation("ServiceAssignment")
  loggedInteractions            Interaction[]
}

model Client {
  id                      String        @id @default(cuid())
  name                    String
  company                 String?
  contactInfo             String?
  status                  ClientStatus  @default(NEW_LEAD)
  pendingNotifications    Boolean       @default(false)
  createdAt               DateTime      @default(now())
  lastModified            DateTime      @updatedAt

  // Relational fields for assigned users
  assignedAdminId           String?
  assignedRelationshipId    String?
  assignedDoctorId          String?
  assignedServiceId         String?

  // Relations to User model
  assignedAdmin             User?         @relation("AdminAssignment", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedRelationship      User?         @relation("RelationshipAssignment", fields: [assignedRelationshipId], references: [id], onDelete: SetNull)
  assignedDoctor            User?         @relation("DoctorAssignment", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  assignedService           User?         @relation("ServiceAssignment", fields: [assignedServiceId], references: [id], onDelete: SetNull)

  // Relations to other models
  interactions              Interaction[]
  deals                     Deal[]
}

model Interaction {
  id          String          @id @default(cuid())
  type        InteractionType
  content     String          @db.Text
  date        DateTime        @default(now())
  
  // Relation to Client
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relation to User who logged it
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id          String      @id @default(cuid())
  name        String
  dealValue   Decimal     @db.Decimal(12, 2)
  grossProfit Decimal     @db.Decimal(12, 2)
  status      DealStatus  @default(PROPOSED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relation to Client
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Strategy {
  id            String          @id @default(cuid())
  name          String
  description   String          @db.Text
  status        StrategyStatus  @default(DRAFT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relation to User (Author)
  authorId      String
  author        User            @relation("StrategyAuthor", fields: [authorId], references: [id])

  // Relation to Documents
  documents     Document[]
}

model Document {
  id          String    @id @default(cuid())
  name        String
  url         String    // URL from a storage provider like Supabase Storage
  uploadedAt  DateTime  @default(now())

  // Relation to Strategy
  strategyId  String
  strategy    Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}
