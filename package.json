{
  "name": "crm-ppa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "find:duplicate-clients": "npx tsx scripts/find-duplicate-clients.ts",
    "test:lead-ingestion": "npx tsx scripts/test-lead-ingestion.ts",
    "test:merge-custom-fields": "npx tsx scripts/test-merge-custom-fields.ts",
    "backfill:deal-participants": "npx tsx scripts/backfill-deal-participants.ts",
    "backfill:deal-participants:dry": "npx tsx scripts/backfill-deal-participants.ts --dry-run",
    "verify:deal-participants": "npx tsx scripts/verify-deal-participants.ts",
    "audit:legacy-commission": "npx tsx scripts/audit-legacy-commission-fallback.ts",
    "test:deal-returnables": "npx tsx scripts/test-deal-returnables.ts",
    "test:deal-participants": "npx tsx scripts/test-deal-participant-calculations.ts",
    "test:deal-participant-api": "npx tsx scripts/test-deal-participant-api.ts",
    "test:client-access": "npx tsx scripts/test-client-access.ts",
    "test:client-strategy": "npx tsx scripts/test-client-strategy-api.ts",
    "test:important-dates": "npx tsx scripts/test-important-dates.ts",
    "test:important-dates-calendar": "npx tsx scripts/test-important-dates-calendar.ts",
    "test:client-contacts": "npx tsx scripts/test-client-contacts.ts",
    "manuals:pdf": "node scripts/generate-manual-pdfs.mjs",
    "test:commission-system": "npx tsx scripts/test-commission-system.ts",
    "test:http": "TEST_BASE_URL=http://localhost:3001 npm run test:commission-system && TEST_BASE_URL=http://localhost:3001 npx tsx scripts/test-activity-apis.ts && TEST_BASE_URL=http://localhost:3001 npx tsx scripts/test-user-management.ts",
    "test:all": "npm run test:deal-participants && npm run test:deal-returnables && npm run verify:deal-participants && npm run test:deal-participant-api && npm run test:client-access && npm run test:client-strategy && npm run test:important-dates && npm run test:important-dates-calendar && npm run test:client-contacts && npm run test:merge-custom-fields && npm run test:lead-ingestion && npx tsx scripts/test-lead-command-center.ts && npm run test:http",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@prisma/client": "^6.19.3",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-table": "^8.21.3",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
